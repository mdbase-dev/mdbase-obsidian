{
  "name": "mdbase-obsidian",
  "version": "0.3.1",
  "description": "The Obsidian gateway to mdbase types and mdbase Connect",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint main.ts src/ package.json --max-warnings=0",
    "lint:ts:fix": "eslint main.ts src/ package.json --fix",
    "lint:css": "stylelint styles.css --max-warnings=0",
    "lint:css:fix": "stylelint styles.css --fix",
    "lint:fix": "npm run lint:ts:fix && npm run lint:css:fix",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:staging": "tsc -noEmit -skipLibCheck && MDBASE_CONNECT_CONTROL_URL=https://connect-staging.mdbase.dev node esbuild.config.mjs production",
    "check:mobile": "npm run build && node scripts/check-mobile.mjs",
    "build:test": "npm run build && node copy-files.mjs",
    "build:test:staging": "npm run build:staging && node copy-files.mjs",
    "profile:testvault": "node scripts/profile-testvault.mjs",
    "test": "npm run test:unit",
    "test:unit": "tsc -p tsconfig.test.json && node --experimental-specifier-resolution=node --loader ./test/obsidian-loader.mjs --test .test-dist/test/**/*.test.js",
    "copy-files": "node copy-files.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "mdbase",
    "frontmatter",
    "schema"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.12.0",
    "@types/picomatch": "^4.0.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^15.15.0",
    "obsidian": "latest",
    "postcss-selector-parser": "^7.1.5",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@callumalpass/mdbase-interop": "0.1.0-rc.2",
    "@mdbase-dev/connect-protocol": "0.1.0-beta.91",
    "@mdbase-dev/connect-sync": "0.1.0-beta.91",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "picomatch": "^4.0.5"
  }
}
