diff --git a/runtime/packages/sdk/src/spike-trace.ts b/runtime/packages/sdk/src/spike-trace.ts
new file mode 100644
index 000000000..9d2cec597
--- /dev/null
+++ b/runtime/packages/sdk/src/spike-trace.ts
@@ -0,0 +1,20 @@
+// SPIKE INSTRUMENTATION (mobile B4). Never released. Wall-clock trace events
+// from the page and the Worker on one BroadcastChannel; the Obsidian spike page
+// forwards them to its trace file. Identifiers only: never URLs, secrets or bodies.
+type Fields = Record<string, string | number | boolean | null | undefined>;
+const Scope = (globalThis as {WorkerGlobalScope?: new () => object}).WorkerGlobalScope;
+const inWorker = typeof Scope === "function" && globalThis instanceof Scope;
+const ctx = inWorker ? `worker:${Math.random().toString(36).slice(2, 6)}` : "page";
+let channel: BroadcastChannel | null = null;
+try { channel = new BroadcastChannel("mdbase-spike-trace"); } catch { channel = null; }
+export function spikeTrace(tag: string, fields: Fields = {}): void {
+  try { channel?.postMessage({t: new Date().toISOString(), ctx, tag, ...fields}); } catch { /* trace only */ }
+}
+/** Path with request/collection ids collapsed. */
+export function spikePath(path: string): string { return path.replace(/[0-9a-f]{8}-[0-9a-f-]{27,}/gi, ":id").replace(/\?.*$/, ""); }
+if (inWorker && channel) {
+  let last = Date.now(), beats = 0;
+  spikeTrace("worker.boot");
+  setInterval(() => { const now = Date.now(), gap = now - last; last = now; beats++; if (gap > 12_000 || beats % 6 === 0) spikeTrace("worker.hb", {gapMs: gap}); }, 5000);
+  channel.onmessage = event => { const ping = (event.data as {ping?: number} | null)?.ping; if (typeof ping === "number") spikeTrace("worker.pong", {ping}); };
+}
