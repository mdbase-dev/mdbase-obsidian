{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "esModuleInterop": true,
    "outDir": ".test-dist",
    "rootDir": ".",
    "inlineSourceMap": false,
    "inlineSources": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "DOM",
      "ES2020"
    ]
  },
  "include": [
    "src/mdbaseCore.ts",
    "src/migration.ts",
    "src/typeModel.ts",
    "src/typeEditorTypes.ts",
    "src/trailingDebouncer.ts",
    "src/sync/*.ts",
    "test/**/*.ts"
  ]
}
